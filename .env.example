# GEMINI_API_KEY: Required only if Gemini API routes are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Development or control-plane origin injected by the runtime environment.
# Note: Google AI Studio ais-dev-*.run.app URLs are private preview proxies and are NEVER used as public live URLs.
APP_URL="MY_APP_URL"

# PORT: Control-plane & build server listening port (default 3000).
PORT=3000

# DATA_DIR: Persistent directory for SQLite database, chunked uploads, extracted workspaces, and builds.
DATA_DIR="./data"

# UPLOAD, EXTRACTION & EXECUTION LIMITS
MAX_UPLOAD_BYTES=5368709120
CHUNK_SIZE_BYTES=4194304
MAX_CHUNK_SIZE_BYTES=33554432
MAX_EXTRACT_BYTES=2147483648
MAX_EXTRACT_FILES=25000
BUILD_TIMEOUT_MS=300000
APP_MEMORY_LIMIT_MB=512
CLEANUP_ABANDONED_HOURS=24

# ==============================================================================
# PUBLIC HOSTING CONFIGURATION (Separated from AI Studio preview environment)
# ==============================================================================
# PRIMARY MANAGED PROVIDER (Vercel):
# Publicly hosts HTML/CSS/JS, built React & Vite outputs, and Next.js (Static & SSR).
# Create a token at: Vercel -> Account Settings -> Tokens
VERCEL_TOKEN=""
# Optional: Only required if deploying into a specific Vercel Team scope
VERCEL_TEAM_ID=""

# CONTAINER / SERVER-SIDE PUBLIC HOSTING RUNTIME:
# Required for Node.js, Python, and Dockerfile server-side applications (and self-hosted static builds)
# Option 1 (Wildcard HTTPS subdomains): e.g. sites.yourdomain.com -> https://<slug>.sites.yourdomain.com/
PUBLIC_BASE_DOMAIN=""

# Option 2 (Dedicated public Cloud Run / VPS HTTPS origin, never ais-dev-*.run.app):
# e.g. https://sites.yourdomain.com -> https://sites.yourdomain.com/sites/<slug>/
PUBLIC_HOSTING_URL=""

# Optional separate HTTP listener port serving ONLY deployed public sites (zero /api/* or workspace routes)
PUBLIC_SITES_PORT=0

# OPTIONAL S3 / R2 DIRECT BROWSER-TO-OBJECT-STORAGE MULTIPART UPLOADS
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
